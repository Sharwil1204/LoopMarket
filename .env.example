# ==============================================================================
# LoopMarket Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# For Vercel Production: configure these environment variables in the Vercel Dashboard
# under Project Settings -> Environment Variables.
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your real .env file or real secrets to git.
# - In production, DEMO_MODE and DEMO_ADMIN_ENABLED must ALWAYS be set to "false".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION DATABASE (Neon PostgreSQL / Vercel Postgres)
# ------------------------------------------------------------------------------
# Automatically set by Vercel when integrating Neon Postgres.
# Example: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
POSTGRES_URL=
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. PRODUCTION IMAGE STORAGE (Vercel Blob)
# ------------------------------------------------------------------------------
# Automatically provided by Vercel when enabling Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 3. WEBSITE OWNER SETUP & SECURITY (Production & Local)
# ------------------------------------------------------------------------------
# Run `npm run owner:invite` to generate a secure 64-character token and its SHA-256 hash.
# Set OWNER_SETUP_TOKEN_HASH and OWNER_SETUP_EXPIRES_AT in Vercel before initial setup.
# After claiming the owner link at https://loopmarket.vercel.app/owner-setup#key=<token>,
# the setup link is permanently disabled.
OWNER_SETUP_TOKEN_HASH=
OWNER_SETUP_EXPIRES_AT=

# ------------------------------------------------------------------------------
# 4. CAMPUS & ENVIRONMENT CONTROLS
# ------------------------------------------------------------------------------
# In production, set DEMO_MODE=false and DEMO_ADMIN_ENABLED=false.
# For local evaluation or demonstration mode, you can set them to true.
DEMO_MODE=false
DEMO_ADMIN_ENABLED=false

# Optional: Comma-separated list of approved campus email domains (e.g. mitadt.edu.in).
# Leave empty to allow any valid email during manual access review.
UNIVERSITY_EMAIL_DOMAINS=

# ------------------------------------------------------------------------------
# 5. LOCAL DEVELOPMENT ONLY (Ignored in production)
# ------------------------------------------------------------------------------
PORT=5173
DATABASE_PATH=.data/loopmarket.sqlite
UPLOAD_DIRECTORY=.data/uploads
